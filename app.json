{
  "expo": {
    "name": "Addis Football",
    "slug": "addis-football",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "addisfootball",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.amanamico.addisfootball",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "telebirrcustomerApp"
        ]
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#071B3A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amanamico.addisfootball"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B3A",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e4c6544-bbea-482b-99ec-f8ad50be7f87"
      }
    }
  }
}